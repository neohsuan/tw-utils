{
  "name": "@hsuan741220/tw-utils",
  "version": "1.0.2",
  "description": "TypeScript utilities for Taiwan identifiers, invoice carriers and ROC dates",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "taiwan",
    "typescript",
    "checksum",
    "roc",
    "統一編號",
    "身分證"
  ],
  "author": "neohsuan",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neohsuan/tw-utils.git"
  },
  "module": "./dist/index.js",
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.2"
    }
  }
}
